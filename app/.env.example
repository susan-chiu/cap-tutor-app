EXPO_PUBLIC_SUPABASE_URL=https://你的專案代碼.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=你的 publishable key（Supabase 後台 Settings → API Keys）
EXPO_PUBLIC_PRIVACY_URL=https://你的網站/privacy
EXPO_PUBLIC_TERMS_URL=https://你的網站/terms
# 收費（RevenueCat 後台 → API keys → 各平台的 Public API key）
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
# 廣告（AdMob 後台建立的「獎勵式」廣告單元 ID；留空會使用 Google 測試廣告）
EXPO_PUBLIC_ADMOB_REWARDED_IOS=
EXPO_PUBLIC_ADMOB_REWARDED_ANDROID=
# 當機回報（Sentry 專案的 DSN；留空則不啟用）
EXPO_PUBLIC_SENTRY_DSN=

# 客服信箱（「我的」→ 聯絡客服、使用說明頁會用到；Apple 審核要求要有客服聯絡方式）
EXPO_PUBLIC_SUPPORT_EMAIL=
